comment6.target=boolean\ hasTarget()
comment6.text=\n\ Returns\ true\ if\ currently\ has\ a\ pose\ target.\n
comment7.params=
comment7.target=boolean\ atTarget()
comment7.text=\n\ Returns\ true\ if\ at\ or\ past\ arrival\ (including\ jitter\ completed).\n
comment8.params=
comment8.target=void\ clearTarget()
comment8.text=\n\ Clears\ pose\ target\ and\ restores\ default\ speed.\n
